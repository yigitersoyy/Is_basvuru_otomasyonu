# Generate real values with: uv run python scripts/configure.py
POSTGRES_PASSWORD=
CAREER_DB_PASSWORD=
N8N_DB_PASSWORD=
API_KEY=
N8N_ENCRYPTION_KEY=
# Live Gmail stays disabled until OAuth is connected and GMAIL_LIVE_ENABLED is explicitly true.
MAIL_TRANSPORT=mailpit
MAIL_FROM=candidate@example.test
# An explicitly downloaded local model; GPU profile is optional.
OLLAMA_MODEL=qwen3.5:9b

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_LIVE_ENABLED=false

# Optional hosted inference. No requests occur unless selected and explicitly enabled.
AI_PROVIDER=ollama
AI_API_ENABLED=false
AI_API_URL=https://api.openai.com/v1
AI_API_MODEL=
AI_API_KEY=
# For native Windows Ollama after setup-ollama.ps1:
# OLLAMA_URL=http://host.docker.internal:11434
